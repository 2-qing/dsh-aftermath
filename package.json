{
  "name": "dsh-aftermath",
  "version": "0.7.1",
  "description": "记录每轮对话中观测目录的文件变更，事后可倒查改了什么、出自哪条命令。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon-256.png"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "GUIDE.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "forensics",
    "snapshot",
    "diff",
    "windows",
    "desktop",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2-qing/dsh-aftermath.git"
  },
  "bugs": {
    "url": "https://github.com/2-qing/dsh-aftermath/issues"
  },
  "homepage": "https://github.com/2-qing/dsh-aftermath#readme",
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      "fs:read",
      "tools:register",
      "network:ingress"
    ],
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "labels": [
      "remote-access"
    ]
  }
}
